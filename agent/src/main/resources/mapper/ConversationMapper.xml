<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.star.agent.memory.ConversationMapper">

    <!-- 存一条对话：created_at 用数据库默认时间，不传 -->
    <insert id="insert" parameterType="com.star.agent.memory.Conversation"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversation (user_id, role, content)
        VALUES (#{userId}, #{role}, #{content})
    </insert>

    <!-- 查某用户最近 limit 条：时间倒序（最新的在前） -->
    <select id="findByUserId" resultType="com.star.agent.memory.Conversation">
        SELECT id, user_id, role, content, created_at
        FROM conversation
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit}
    </select>

    <!-- 删某用户的全部对话（测试清理） -->
    <delete id="deleteByUserId">
        DELETE FROM conversation WHERE user_id = #{userId}
    </delete>

</mapper>