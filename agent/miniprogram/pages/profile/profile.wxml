<view class="page">
  <!-- 顶部品牌区 -->
  <view class="hero">
    <view class="hero-ico"></view>
    <view class="hero-title">星链智核</view>
    <view class="hero-sub">全域自适应多端 AI 智能助手</view>
  </view>

  <!-- 已登录 -->
  <block wx:if="{{logged}}">
    <view class="user-card">
      <view class="avatar">{{avatar}}</view>
      <view class="u-info">
        <view class="u-name">{{username}}</view>
        <view class="u-uid">ID: {{userId}}</view>
      </view>
      <view class="badge">已登录</view>
    </view>

    <view class="sync-card">
      <view class="sync-title">三端互通</view>
      <view class="sync-desc">微信对话 · Web 网页 · 小程序 — 同一账号，知识库 / 记忆 / 猎聘配置完全同步</view>
      <view class="sync-items">
        <view class="sync-item">
          <view class="si-ico i1"></view>
          <text>私有知识库</text>
        </view>
        <view class="sync-item">
          <view class="si-ico i2"></view>
          <text>对话记忆</text>
        </view>
        <view class="sync-item">
          <view class="si-ico i3"></view>
          <text>租房决策</text>
        </view>
      </view>
    </view>

    <!-- 助手人设卡 -->
    <view class="sync-card">
      <view class="sync-title">助手人设</view>
      <view class="sync-desc" wx:if="{{personaConfigured}}">当前：{{personaText}}</view>
      <view class="sync-desc" wx:else>未设置 · 默认助手（可自定义人设或选预设）</view>
      <view class="lp-actions" wx:if="{{!personaEditing}}">
        <view class="lp-act" bindtap="togglePersonaEdit">{{personaConfigured ? '更换' : '设置'}}</view>
        <view class="lp-act danger" wx:if="{{personaConfigured}}" bindtap="clearPersona">恢复默认</view>
      </view>
      <view class="lp-box" wx:if="{{personaEditing}}">
        <view class="preset-row">
          <view class="preset-chip" wx:for="{{presets}}" wx:key="id" data-id="{{item.id}}" bindtap="pickPreset">{{item.name}}</view>
        </view>
        <textarea class="persona-area" placeholder="自定义人设，如：你是东北雨姐，说话豪爽" value="{{personaDraft}}" bindinput="onPersonaInput" maxlength="200" />
        <view class="lp-err" wx:if="{{personaErr}}">{{personaErr}}</view>
        <view class="preset-actions">
          <view class="lp-act" bindtap="togglePersonaEdit">取消</view>
          <view class="lp-act primary" bindtap="savePersona">保存生效</view>
        </view>
      </view>
    </view>

    <view class="sync-card">
      <view class="sync-title">猎聘求职</view>
      <view class="sync-desc" wx:if="{{!lpConfigured}}">配置猎聘 Token 后，可查岗位 / 精筛 / 读简历（获取：猎聘官网 mcp/auth 登录生成）</view>
      <view class="sync-desc" wx:else>已配置<text wx:if="{{lpUpdatedAt}}"> · {{lpUpdatedAt}}</text></view>
      <view class="lp-box" wx:if="{{lpEditing || !lpConfigured}}">
        <input class="lp-ipt" placeholder="粘贴你的猎聘 Token" value="{{lpToken}}" bindinput="onLpToken" />
        <view class="lp-err" wx:if="{{lpErr}}">{{lpErr}}</view>
        <button class="lp-btn" bindtap="saveLpToken" loading="{{lpSaving}}" disabled="{{lpSaving}}">保存 Token</button>
      </view>
      <view class="lp-actions" wx:else>
        <view class="lp-act" bindtap="toggleLpEdit">更换</view>
        <view class="lp-act danger" bindtap="removeLpToken">删除</view>
      </view>
    </view>

    <view class="logout" bindtap="onLogout">退出登录</view>
  </block>

  <!-- 未登录 -->
  <block wx:else>
    <view class="login-box">
      <view class="login-ico"></view>
      <view class="login-t">登录</view>
      <view class="login-s">与 Web / 微信同一账号体系</view>
      <view class="fld">
        <view class="fld-ico u"></view>
        <input class="fld-ipt" placeholder="用户名" value="{{username}}" bindinput="onUsername" />
      </view>
      <view class="fld">
        <view class="fld-ico p"></view>
        <input class="fld-ipt" placeholder="密码" password value="{{password}}" bindinput="onPassword" />
      </view>
      <button class="login-btn" bindtap="onLogin" loading="{{loading}}" disabled="{{loading}}">登 录</button>
      <view class="err" wx:if="{{err}}">{{err}}</view>
      <view class="hint">未注册？填一个未占用用户名直接登录将自动创建账号（与 Web 端注册互通）</view>
    </view>
  </block>
</view>