/* pages/knowledge/knowledge.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
  box-sizing: border-box;
}
.head {
  margin-bottom: 24rpx;
}
.up {
  background: #4a6cf7;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.up[disabled] {
  background: #a9b8f8;
  color: #fff;
}
.upbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 10;
}
.bar {
  height: 12rpx;
  background: #e8ecf7;
  border-radius: 6rpx;
  overflow: hidden;
}
.fill {
  height: 100%;
  background: #4a6cf7;
  border-radius: 6rpx;
  transition: width 0.2s ease;
}
.uptxt {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}
.id {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.del {
  color: #e54d42;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}
.tip {
  color: #bbb;
  font-size: 24rpx;
  margin-top: 16rpx;
}