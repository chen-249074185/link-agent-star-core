<view class="page">
  <view class="head">
    <button class="up" bindtap="chooseUpload" disabled="{{uploading}}">{{uploading ? '上传中…' : '上传文档'}}</button>
  </view>

  <view class="upbar" wx:if="{{uploading}}">
    <view class="bar"><view class="fill" style="width: {{uploadProgress}}%;"></view></view>
    <text class="uptxt">{{uploadStatus}} {{uploadProgress}}%</text>
  </view>

  <view class="tiprow" wx:if="{{files.length}}">默认知识库 · 共 {{files.length}} 个文件</view>

  <view class="list" wx:if="{{files.length}}">
    <view class="row" wx:for="{{files}}" wx:key="name">
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="meta">{{item.count}}<text wx:if="{{item.time}}"> · {{item.time}}</text></view>
      </view>
      <view class="del" data-name="{{item.name}}" catchtap="onDel">删除</view>
    </view>
  </view>

  <view class="empty" wx:elif="{{!loading}}">
    <text>知识库暂无文件</text>
    <text class="tip">点击上方按钮上传文档，AI 将基于你的资料回答</text>
  </view>
</view>