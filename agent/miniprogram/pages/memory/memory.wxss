/* pages/memory/memory.wxss */
.page {
  min-height: 100vh;
  background: #f5f6fa;
  box-sizing: border-box;
}

/* ===== 顶部品牌区 ===== */
.hero {
  padding: 40rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #5b7cfa 0%, #7c6bf2 55%, #9b6df0 100%);
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(91, 124, 250, 0.25);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  right: -60rpx;
  top: -90rpx;
}
.hero-title {
  position: relative;
  color: #fff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-sub {
  position: relative;
  color: rgba(255, 255, 255, 0.78);
  font-size: 23rpx;
  margin-top: 10rpx;
}

/* ===== 搜索 ===== */
.search {
  display: flex;
  align-items: center;
  margin: 28rpx 28rpx 22rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 12rpx 14rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 74, 120, 0.06);
}
.search-ico {
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #a0a6b8;
  border-radius: 50%;
  position: relative;
  margin-right: 18rpx;
  flex-shrink: 0;
}
.search-ico::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 16rpx;
  background: #a0a6b8;
  border-radius: 4rpx;
  right: -6rpx;
  bottom: -8rpx;
  transform: rotate(-45deg);
}
.s-ipt {
  flex: 1;
  font-size: 28rpx;
}
.s-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #5b7cfa, #8a6df0);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  padding: 12rpx 34rpx;
}

/* ===== 会话卡片 ===== */
.list {
  padding: 0 28rpx;
}
.row {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 74, 120, 0.06);
}
.s-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.c0 { background: linear-gradient(135deg, #5b7cfa, #7c6bf2); }
.c1 { background: linear-gradient(135deg, #6f86ff, #9b6df0); }
.c2 { background: linear-gradient(135deg, #8a6df0, #b08cf2); }
.c3 { background: linear-gradient(135deg, #5aa7ff, #3d82f7); }
.c4 { background: linear-gradient(135deg, #3ecf8e, #23a66a); }
.info {
  flex: 1;
  min-width: 0;
}
.title {
  font-size: 30rpx;
  color: #2b2f3a;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta {
  font-size: 23rpx;
  color: #a0a6b8;
  margin-top: 8rpx;
}
.del {
  flex-shrink: 0;
  color: #e54d42;
  font-size: 25rpx;
  padding: 12rpx 8rpx 12rpx 24rpx;
  margin-left: 12rpx;
}

/* ===== 空状态 ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  color: #999;
}
.empty-ico {
  width: 130rpx;
  height: 130rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #eef0fb, #e8e6fa);
  position: relative;
  margin-bottom: 34rpx;
}
.empty-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 40%;
  width: 36rpx;
  height: 48rpx;
  background: #b9c1f5;
  border-radius: 8rpx;
  transform: translateX(-50%);
}
.empty-ico::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 44%;
  width: 14rpx;
  height: 30rpx;
  background: #fff;
  border-radius: 6rpx;
  transform: translateX(-50%);
}
.empty-t {
  font-size: 30rpx;
  color: #6b7285;
  font-weight: 600;
}
.empty-s {
  font-size: 24rpx;
  color: #b0b6c6;
  margin-top: 14rpx;
}

/* ===== 详情视图 ===== */
.detail {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.dhead {
  padding: 24rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef0f6;
}
.back {
  color: #5b7cfa;
  font-size: 28rpx;
  font-weight: 600;
  padding: 8rpx 0;
}
.dscroll {
  flex: 1;
  height: 0;
  padding: 28rpx;
  box-sizing: border-box;
}
.msg {
  display: flex;
  margin-bottom: 24rpx;
}
.msg.user {
  justify-content: flex-end;
}
.msg.assistant {
  justify-content: flex-start;
}
.dava {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.dava.user {
  order: 2;
  margin-left: 14rpx;
  background: linear-gradient(135deg, #6f86ff, #9b6df0);
}
.dava.assistant {
  margin-right: 14rpx;
  background: linear-gradient(135deg, #5b7cfa, #7c6bf2);
}
.bubble {
  max-width: 74%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-all;
}
.msg.user .bubble {
  background: linear-gradient(135deg, #6f86ff, #8a6df0);
  color: #fff;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
}
.msg.assistant .bubble {
  background: #fff;
  color: #333;
  border-radius: 20rpx 20rpx 20rpx 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 74, 120, 0.07);
}