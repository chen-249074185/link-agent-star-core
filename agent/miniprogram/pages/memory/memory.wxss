/* pages/memory/memory.wxss */
.page {
  height: 100vh;
  background: #f5f6fa;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.head {
  margin-bottom: 24rpx;
}
.search {
  display: flex;
  align-items: center;
}
.ipt {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}
.btn {
  background: #4a6cf7;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 32rpx;
}
.back {
  color: #4a6cf7;
  font-size: 30rpx;
  padding: 8rpx 0;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}
.meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.del {
  color: #e54d42;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
  padding-top: 200rpx;
}
.tip {
  color: #bbb;
  font-size: 24rpx;
  margin-top: 16rpx;
}
.detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.dscroll {
  flex: 1;
}
.msg {
  display: flex;
  margin-bottom: 20rpx;
}
.msg.user {
  justify-content: flex-end;
}
.msg.assistant {
  justify-content: flex-start;
}
.bubble {
  max-width: 85%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg.user .bubble {
  background: #4a6cf7;
  color: #fff;
}
.msg.assistant .bubble {
  background: #fff;
  color: #333;
}