<view class="page">
  <view class="head" wx:if="{{!viewing}}">
    <view class="search">
      <input class="ipt" placeholder="搜索对话内容" value="{{keyword}}" bindinput="onSearch" confirm-type="search" bindconfirm="doSearch" />
      <view class="btn" bindtap="doSearch">搜索</view>
    </view>
  </view>
  <view class="head" wx:else>
    <view class="back" bindtap="backToList">← 返回列表</view>
  </view>

  <block wx:if="{{!viewing}}">
    <view class="list" wx:if="{{sessions.length}}">
      <view class="row" wx:for="{{sessions}}" wx:key="sessionId" data-sid="{{item.sessionId}}" bindtap="openDetail">
        <view class="info">
          <view class="title">{{item.title}}</view>
          <view class="meta">{{item.time}} · {{item.count}} 条</view>
        </view>
        <view class="del" data-sid="{{item.sessionId}}" catchtap="onDel">删除</view>
      </view>
    </view>
    <view class="empty" wx:elif="{{!loading}}">
      <text>暂无对话记录</text>
      <text class="tip">去对话页聊几句，历史会保存在这里</text>
    </view>
  </block>

  <view class="detail" wx:else>
    <scroll-view scroll-y class="dscroll">
      <view class="msg {{item.role}}" wx:for="{{detail}}" wx:key="index">
        <view class="bubble">{{item.content}}</view>
      </view>
    </scroll-view>
    <view class="empty" wx:if="{{!detail.length}}">该会话暂无内容</view>
  </view>
</view>