/* pages/index/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.chat {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}
.msg {
  display: flex;
  margin-bottom: 24rpx;
}
.msg.user {
  justify-content: flex-end;
}
.msg.assistant {
  justify-content: flex-start;
}
.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}
.msg.user .bubble {
  background: #4a6cf7;
  color: #fff;
}
.msg.assistant .bubble {
  background: #fff;
  color: #333;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}
.ipt {
  flex: 1;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  margin-right: 16rpx;
}
.send {
  background: #4a6cf7;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 0 32rpx;
}
.send-disabled {
  background: #a9b8f8;
}