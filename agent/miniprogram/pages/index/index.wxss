/* pages/index/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f6fa;
}

/* ===== 消息区 ===== */
.chat {
  flex: 1;
  height: 0;
  padding: 32rpx 30rpx 16rpx;
  box-sizing: border-box;
}
.inner {
  max-width: 720rpx;
  margin: 0 auto;
}

/* 欢迎空状态：屏幕垂直居中偏下 */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding-top: 170px;
}
.w-ico {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #5b7cfa, #9b6df0);
  box-shadow: 0 16rpx 36rpx rgba(91, 124, 250, 0.3);
  position: relative;
  margin-bottom: 32rpx;
}
.w-ico::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 46%;
  width: 36rpx;
  height: 36rpx;
  border: 6rpx solid #fff;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.w-t {
  font-size: 32rpx;
  color: #33384a;
  font-weight: 700;
}
.w-s {
  font-size: 23rpx;
  color: #a0a6b8;
  margin-top: 14rpx;
}
.w-chip {
  margin-top: 30rpx;
  background: #fff;
  border: 1rpx solid #e3e7f5;
  border-radius: 32rpx;
  padding: 16rpx 30rpx;
  font-size: 24rpx;
  color: #5b7cfa;
  box-shadow: 0 4rpx 14rpx rgba(60, 74, 120, 0.06);
}

/* 消息流 */
.msg {
  display: flex;
  margin-bottom: 30rpx;
}
.msg.user {
  justify-content: flex-end;
}
.mava {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 6rpx;
}
.mava.user {
  order: 2;
  margin-left: 16rpx;
  background: linear-gradient(135deg, #6f86ff, #9b6df0);
  position: relative;
}
.mava.user::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 30%;
  width: 18rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  transform: translateX(-50%);
}
.mava.user::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 66%;
  width: 32rpx;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx 16rpx 0 0;
  transform: translateX(-50%);
}
.mava.assistant {
  margin-right: 16rpx;
  background: linear-gradient(135deg, #5b7cfa, #7c6bf2);
  position: relative;
}
.mava.assistant::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 40%;
  width: 10rpx;
  height: 10rpx;
  background: #fff;
  border-radius: 50%;
  box-shadow: 20rpx 0 0 #fff;
  transform: translate(-50%, -50%);
}
.wrap {
  max-width: 72%;
  display: flex;
  flex-direction: column;
}
.msg.user .wrap {
  align-items: flex-end;
}
.bubble {
  padding: 22rpx 26rpx;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-all;
  white-space: pre-wrap;
}
.msg.user .bubble {
  background: linear-gradient(135deg, #6f86ff, #8a6df0);
  color: #fff;
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(111, 134, 255, 0.28);
}
.msg.assistant .bubble {
  background: #fff;
  color: #333;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 74, 120, 0.07);
}
.time {
  font-size: 20rpx;
  color: #b0b6c6;
  margin: 8rpx 12rpx 0;
}
.msg.user .time {
  margin-right: 4rpx;
}

/* 正在思考 */
.bubble.typing {
  display: flex;
  align-items: center;
  padding: 26rpx 30rpx;
}
.tdot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b9c1f5;
  margin: 0 6rpx;
  animation: tdot 1.2s infinite ease-in-out;
}
.tdot:nth-child(2) { animation-delay: 0.2s; }
.tdot:nth-child(3) { animation-delay: 0.4s; }
@keyframes tdot {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* ===== 输入卡 ===== */
.composer {
  flex: none;
  padding: 14rpx 28rpx 22rpx;
  background: #fff;
  box-shadow: 0 -6rpx 24rpx rgba(60, 74, 120, 0.06);
}
.chat-tools {
  display: flex;
  align-items: center;
  margin: 0 auto 14rpx;
  max-width: 720rpx;
}
.newchat {
  font-size: 24rpx;
  color: #5b7cfa;
  font-weight: 600;
  background: #f2f4fb;
  border-radius: 26rpx;
  padding: 8rpx 22rpx;
}
.session-tip {
  margin-left: auto;
  font-size: 20rpx;
  color: #b0b6c6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 40%;
}
.composer-inner {
  max-width: 720rpx;
  margin: 0 auto;
}
.composer-box {
  display: flex;
  align-items: center;
  background: #f2f4fb;
  border: 2rpx solid transparent;
  border-radius: 44rpx;
  padding: 12rpx 12rpx 12rpx 34rpx;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.composer-box.focused {
  border-color: #7c6bf2;
  box-shadow: 0 0 0 6rpx rgba(124, 107, 242, 0.12);
}
.ipt {
  flex: 1;
  background: transparent;
  font-size: 29rpx;
  line-height: 1.5;
}
.ipt-ph {
  color: #b0b6c6;
}
.send {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b7cfa, #9b6df0);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(91, 124, 250, 0.35);
  transition: 0.15s;
}
.send-disabled {
  background: #c3cae8;
  box-shadow: none;
}
.send-arrow {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #fff;
  border-bottom: none;
  border-left: none;
  transform: rotate(45deg) translate(-3rpx, 3rpx);
}